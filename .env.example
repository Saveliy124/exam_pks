EXAM_DB_NAME=exam_center
EXAM_DB_USER=exam_center
EXAM_DB_PASSWORD=replace-with-a-local-password
EXAM_DB_PORT=55433

# HTTP-порты нашего Spring Boot (пример преподавателя остаётся на 8080)
EXAM_API_PORT=8081
EXAM_DEMO_API_PORT=8082

# KR3: scripts/kr3-env.py creates random values in ignored .env
EXAM_WEB_DB_NAME=exam_center_kr3
EXAM_WEB_DB_USER=exam_web
EXAM_WEB_DB_PASSWORD=replace-with-random-password
EXAM_WEB_DB_PORT=55435
EXAM_WEB_PORT=8080
JWT_SECRET_BASE64=replace-with-base64-of-at-least-32-random-bytes
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-temporary-password
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=true
