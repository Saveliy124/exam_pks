<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.examcenter.fx.controller.StatusFormController" prefWidth="520" spacing="18" styleClass="form-root">
 <padding><Insets top="28" right="28" bottom="24" left="28"/></padding>
 <VBox fx:id="formBody" spacing="15">
 <Label fx:id="titleLabel" styleClass="dialog-title"/>
 <Label fx:id="summaryLabel" styleClass="info-box" wrapText="true" maxWidth="Infinity"/>
 <VBox fx:id="scoreBox" spacing="6"><Label text="Результат экзамена *" styleClass="field-label"/><TextField fx:id="scoreField" promptText="Целое число от 0 до 100"/>
 <Label text="Результат можно записать после назначенного времени экзамена." styleClass="subtitle" wrapText="true"/></VBox>
</VBox>
 <Label fx:id="errorLabel" styleClass="error-box" wrapText="true" maxWidth="Infinity"/>
 <Separator/>
 <HBox spacing="10" alignment="CENTER_RIGHT">
  <ProgressIndicator fx:id="formProgress" prefWidth="22" prefHeight="22" maxWidth="22" maxHeight="22"/>
  <Region HBox.hgrow="ALWAYS"/>
  <Button fx:id="closeButton" text="Отмена" onAction="#close" cancelButton="true"/>
  <Button fx:id="saveButton" text="Сохранить" onAction="#save" defaultButton="true" styleClass="primary"/>
 </HBox>
</VBox>