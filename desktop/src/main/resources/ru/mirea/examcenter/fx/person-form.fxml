<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.examcenter.fx.controller.PersonFormController" prefWidth="540" spacing="18" styleClass="form-root">
 <padding><Insets top="28" right="28" bottom="24" left="28"/></padding>
 <VBox fx:id="formBody" spacing="15">
 <Label fx:id="titleLabel" styleClass="dialog-title"/>
 <Label fx:id="subtitleLabel" styleClass="subtitle" wrapText="true"/>
 <VBox spacing="6"><Label text="ФИО *" styleClass="field-label"/><TextField fx:id="fullNameField" promptText="От 2 до 120 символов"/></VBox>
 <VBox spacing="6"><Label text="Email *" styleClass="field-label"/><TextField fx:id="emailField" promptText="name@example.org"/></VBox>
 <VBox spacing="6"><Label fx:id="extraLabel" styleClass="field-label"/><TextField fx:id="extraField"/></VBox>
 <VBox spacing="6"><Label text="Статус *" styleClass="field-label"/><ComboBox fx:id="statusField" maxWidth="Infinity"/></VBox>
</VBox>
 <Label fx:id="errorLabel" styleClass="error-box" wrapText="true" maxWidth="Infinity"/>
 <Separator/>
 <HBox spacing="10" alignment="CENTER_RIGHT">
  <ProgressIndicator fx:id="formProgress" prefWidth="22" prefHeight="22" maxWidth="22" maxHeight="22"/>
  <Region HBox.hgrow="ALWAYS"/>
  <Button fx:id="closeButton" text="Отмена" onAction="#close" cancelButton="true"/>
  <Button fx:id="saveButton" text="Сохранить" onAction="#save" defaultButton="true" styleClass="primary"/>
 </HBox>
</VBox>