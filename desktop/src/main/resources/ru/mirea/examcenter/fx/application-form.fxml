<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.examcenter.fx.controller.ApplicationFormController" prefWidth="650" spacing="18" styleClass="form-root">
 <padding><Insets top="28" right="28" bottom="24" left="28"/></padding>
 <VBox fx:id="formBody" spacing="15">
 <Label fx:id="titleLabel" styleClass="dialog-title"/>
 <Label fx:id="detailsLabel" styleClass="info-box" wrapText="true" maxWidth="Infinity"/>
 <VBox spacing="6"><Label text="Кандидат *" styleClass="field-label"/><ComboBox fx:id="applicantField" promptText="Выберите кандидата из списка" maxWidth="Infinity"/></VBox>
 <VBox spacing="6"><Label text="Экзамен *" styleClass="field-label"/><TextField fx:id="examField" promptText="Название экзамена, от 2 до 120 символов"/></VBox>
 <HBox spacing="16" alignment="BOTTOM_LEFT">
  <VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Дата экзамена *" styleClass="field-label"/><DatePicker fx:id="dateField" maxWidth="Infinity"/></VBox>
  <VBox spacing="6"><Label text="Часы" styleClass="field-label"/><TextField fx:id="hourField" prefWidth="72" maxWidth="72" promptText="0–23"/></VBox>
  <VBox spacing="6"><Label text="Минуты" styleClass="field-label"/><TextField fx:id="minuteField" prefWidth="72" maxWidth="72" promptText="0–59"/></VBox>
 </HBox>
 <Label text="Дата и время экзамена должны быть в будущем. Используется местное время компьютера." styleClass="subtitle" wrapText="true"/>
</VBox>
 <Label fx:id="errorLabel" styleClass="error-box" wrapText="true" maxWidth="Infinity"/>
 <Separator/>
 <HBox spacing="10" alignment="CENTER_RIGHT">
  <ProgressIndicator fx:id="formProgress" prefWidth="22" prefHeight="22" maxWidth="22" maxHeight="22"/>
  <Region HBox.hgrow="ALWAYS"/>
  <Button fx:id="closeButton" text="Отмена" onAction="#close" cancelButton="true"/>
  <Button fx:id="saveButton" text="Сохранить" onAction="#save" defaultButton="true" styleClass="primary"/>
 </HBox>
</VBox>
